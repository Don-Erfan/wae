{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Don-Erfan/wae/master/schemas/wae.schema.json",
  "title": "WAE configuration",
  "description": "Versioned configuration for Web Architecture Engine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "project": { "$ref": "#/$defs/project" },
    "resolution": { "$ref": "#/$defs/resolution" },
    "architecture": { "$ref": "#/$defs/architecture" },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ARCH-001": { "$ref": "#/$defs/rule" }, "ARCH-002": { "$ref": "#/$defs/rule" },
        "ARCH-003": { "$ref": "#/$defs/rule" }, "ARCH-004": { "$ref": "#/$defs/rule" },
        "ARCH-005": { "$ref": "#/$defs/rule" }, "ARCH-006": { "$ref": "#/$defs/rule" },
        "ARCH-007": { "$ref": "#/$defs/rule" }, "ARCH-008": { "$ref": "#/$defs/rule" },
        "ARCH-009": { "$ref": "#/$defs/rule" }, "ARCH-010": { "$ref": "#/$defs/rule" },
        "ARCH-011": { "$ref": "#/$defs/rule" },
        "PACKAGE-001": { "$ref": "#/$defs/rule" }, "PACKAGE-002": { "$ref": "#/$defs/rule" },
        "PACKAGE-003": { "$ref": "#/$defs/rule" }, "PACKAGE-004": { "$ref": "#/$defs/rule" },
        "RUNTIME-001": { "$ref": "#/$defs/rule" }, "RUNTIME-002": { "$ref": "#/$defs/rule" },
        "RUNTIME-003": { "$ref": "#/$defs/rule" }, "RUNTIME-004": { "$ref": "#/$defs/rule" },
        "RUNTIME-005": { "$ref": "#/$defs/rule" }, "RUNTIME-006": { "$ref": "#/$defs/rule" }
      }
    },
    "baseline": { "$ref": "#/$defs/baseline" },
    "output": { "$ref": "#/$defs/output" },
    "cache": { "$ref": "#/$defs/cache" },
    "suppressions": { "$ref": "#/$defs/suppressions" },
    "framework": { "$ref": "#/$defs/framework" },
    "runtime": { "$ref": "#/$defs/runtime" }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "project": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "include": { "$ref": "#/$defs/stringList" }, "exclude": { "$ref": "#/$defs/stringList" },
        "roots": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "follow_symlinks": { "type": "boolean" }, "max_file_size_kb": { "type": "integer", "minimum": 1 }
      }
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["node", "node10", "node16", "nodenext", "bundler"] },
        "custom_conditions": { "$ref": "#/$defs/stringList" }
      }
    },
    "architecture": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "layers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/layer" } },
        "coverage": { "$ref": "#/$defs/coverage" },
        "features": { "$ref": "#/$defs/features" },
        "forbidden_dependencies": { "$ref": "#/$defs/forbiddenList" },
        "forbidden_package_dependencies": { "$ref": "#/$defs/forbiddenList" },
        "presets": {
          "type": "object", "additionalProperties": false,
          "properties": { "monorepo_boundaries": { "type": "boolean" } }
        }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "minimum": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "allow_unassigned": { "$ref": "#/$defs/stringList" }
      }
    },
    "layer": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "patterns": { "$ref": "#/$defs/stringList" },
        "canImport": { "$ref": "#/$defs/stringList" },
        "can_import": { "$ref": "#/$defs/stringList", "deprecated": true }
      }
    },
    "features": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "root": { "type": "string" }, "roots": { "$ref": "#/$defs/stringList" },
        "public_entrypoints": { "$ref": "#/$defs/stringList" },
        "private_segments": { "$ref": "#/$defs/stringList" }
      }
    },
    "forbiddenList": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to"],
        "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
      }
    },
    "severity": { "enum": ["error", "warning", "info"] },
    "rule": {
      "oneOf": [
        { "$ref": "#/$defs/severity" },
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }, "severity": { "$ref": "#/$defs/severity" },
            "max_depth": { "type": "integer", "minimum": 1 },
            "max_fan_out": { "type": "integer", "minimum": 1 },
            "max_fan_in": { "type": "integer", "minimum": 1 },
            "entrypoints": { "$ref": "#/$defs/stringList" }
          }
        }
      ]
    },
    "baseline": { "type": "object", "additionalProperties": false, "properties": { "file": { "type": "string" } } },
    "output": { "type": "object", "additionalProperties": false, "properties": { "format": { "enum": ["human", "json", "jsonl", "sarif"] }, "fail_on": { "enum": ["error", "warning"] }, "max_warnings": { "type": ["integer", "null"], "minimum": 0 } } },
    "cache": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "directory": { "type": "string" } } },
    "suppressions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_reason": { "type": "boolean" },
        "report_unused": { "type": "boolean" },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern", "rules", "reason"],
            "properties": {
              "pattern": { "type": "string", "minLength": 1 },
              "rules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "reason": { "type": "string" }
            }
          }
        },
        "fingerprints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fingerprint", "reason"],
            "properties": {
              "fingerprint": { "type": "string", "minLength": 1 },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "framework": { "type": "object", "additionalProperties": false, "properties": { "auto_detect": { "type": "boolean" }, "enabled": { "type": "array", "items": { "enum": ["nextjs"] }, "uniqueItems": true } } },
    "runtime": { "type": "object", "additionalProperties": false, "properties": { "browser_incompatible_packages": { "$ref": "#/$defs/stringList" }, "edge_incompatible_packages": { "$ref": "#/$defs/stringList" } } }
  }
}
