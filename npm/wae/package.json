{
  "name": "@don-erfan/wae",
  "version": "1.0.0",
  "description": "WAE CLI wrapper for frontend architecture checks",
  "license": "MIT",
  "keywords": [
    "architecture",
    "lint",
    "dependency-graph",
    "nextjs",
    "monorepo",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Don-Erfan/wae.git"
  },
  "homepage": "https://github.com/Don-Erfan/wae",
  "bugs": {
    "url": "https://github.com/Don-Erfan/wae/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "preferUnplugged": true,
  "files": [
    "bin",
    "lib",
    "scripts",
    "checksums.json",
    "README.md"
  ],
  "bin": {
    "wae": "bin/wae.js",
    "wae-lsp": "bin/wae-lsp.js",
    "wae-mcp": "bin/wae-mcp.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "pack:check": "npm pack --dry-run",
    "test:installer": "node --test test/*.test.js"
  },
  "wae": {
    "githubRepo": "Don-Erfan/wae"
  }
}
