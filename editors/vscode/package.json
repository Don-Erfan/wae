{
  "name": "wae-vscode",
  "displayName": "Web Architecture Engine",
  "description": "Live WAE architecture diagnostics, dependency paths, rule explanations and an architecture explorer.",
  "version": "1.0.0",
  "publisher": "don-erfan",
  "repository": {
    "type": "git",
    "url": "https://github.com/Don-Erfan/wae.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "WAE",
      "properties": {
        "wae.server.path": {
          "type": "string",
          "default": "wae-lsp",
          "description": "Path to the wae-lsp executable. The default uses the workspace's node_modules/.bin/wae-lsp (installed with @don-erfan/wae) and falls back to wae-lsp on PATH."
        }
      }
    },
    "commands": [
      {
        "command": "wae.check",
        "title": "WAE: Check Project"
      },
      {
        "command": "wae.explainRulePrompt",
        "title": "WAE: Explain Rule..."
      },
      {
        "command": "wae.inspectCurrentModule",
        "title": "WAE: Inspect Module (Dependencies, Dependents, Runtime)"
      },
      {
        "command": "wae.refreshArchitecture",
        "title": "WAE: Refresh Architecture Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "wae.graph",
        "title": "WAE: Print Dependency Graph (terminal)"
      },
      {
        "command": "wae.reload",
        "title": "WAE: Restart Language Server"
      },
      {
        "command": "wae.openLocation",
        "title": "WAE: Open Location"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wae",
          "title": "WAE Architecture",
          "icon": "media/architecture.svg"
        }
      ]
    },
    "views": {
      "wae": [
        {
          "id": "wae.architecture",
          "name": "Architecture"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "wae.refreshArchitecture",
          "when": "view == wae.architecture",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "wae.inspectCurrentModule",
          "when": "view == wae.architecture && viewItem == waeModule"
        }
      ],
      "editor/context": [
        {
          "command": "wae.inspectCurrentModule",
          "when": "resourceLangId =~ /^(javascript|typescript)(react)?$/",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "wae.openLocation",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=out/extension.js",
    "compile:test": "esbuild src/test/runTest.ts --bundle --platform=node --outfile=out/test/runTest.js && esbuild src/test/suite/index.ts --bundle --platform=node --external:vscode --outfile=out/test/suite/index.js",
    "check": "tsc -p ./ --noEmit",
    "test:e2e": "npm run compile && npm run compile:test && node out/test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "brace-expansion": "2.1.7"
  }
}
